{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OsuSkinMaker",
  "version": "0.1.0",
  "identifier": "com.osuskin.maker",
  "build": {
    "beforeDevCommand": "npm run dev:server",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OsuSkinMaker v0.1.0",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}